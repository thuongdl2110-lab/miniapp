# Zalo App credentials - lấy từ https://developers.zalo.me/app
ZALO_APP_ID=your_app_id_here
ZALO_APP_SECRET=your_app_secret_here

# Server config
PORT=5000

# Thêm domain origin được phép CORS (cách nhau bởi dấu phẩy).
# Prod Mini App của Zalo: https://h5.zdn.vn (đã mặc định trong code).
# CORS_ORIGINS=https://staging.example.com,https://app.example.com
